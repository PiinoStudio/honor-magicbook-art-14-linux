# Disable wakeup triggers that abort or prevent deep s2idle
ACTION=="add|bind", SUBSYSTEM=="platform", KERNEL=="gpio-keys", ATTR{power/wakeup}="enabled"
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="qcom-battmgr-*|ucsi-source-psy-*", TEST=="power/wakeup", ATTR{power/wakeup}="disabled"
ACTION=="add|bind", SUBSYSTEM=="mhi", KERNEL=="mhi0", TEST=="power/wakeup", ATTR{power/wakeup}="disabled"
ACTION=="add|bind", SUBSYSTEM=="platform", KERNEL=="32300000.remoteproc", TEST=="power/wakeup", ATTR{power/wakeup}="disabled"
ACTION=="add|bind", SUBSYSTEM=="i2c", KERNEL=="1-003a|2-005d", TEST=="power/wakeup", ATTR{power/wakeup}="disabled"

# Enable runtime PM autosuspend for XHCI USB controllers
ACTION=="add", SUBSYSTEM=="platform", KERNEL=="xhci-hcd.*.auto", ATTR{power/control}="auto"

# Disable flapping FPC fingerprint reader on USB (prevents constant wake/reset loops)
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="10a5", ATTR{idProduct}=="9924", ATTR{authorized}="0"
